#!/bin/bash

fix_existing_prefs_owner() {
  for prefs in \
    /var/mobile/Library/Preferences/com.be-huge.insulation-prefs.plist \
    /var/jb/var/mobile/Library/Preferences/com.be-huge.insulation-prefs.plist \
    /var/containers/Bundle/Application/.jbroot-*/var/mobile/Library/Preferences/com.be-huge.insulation-prefs.plist; do
    if [ -e "$prefs" ]; then
      chown mobile:mobile "$prefs" 2>/dev/null || true
      chmod 644 "$prefs" 2>/dev/null || true
    fi
  done
}

resolve_insulationctl() {
  local resolved=""
  resolved="$(command -v insulationctl 2>/dev/null || true)"
  if [ -n "$resolved" ] && [ -x "$resolved" ]; then
    printf '%s\n' "$resolved"
    return 0
  fi

  for tool in \
    /usr/bin/insulationctl \
    /var/jb/usr/bin/insulationctl \
    /var/containers/Bundle/Application/.jbroot-*/usr/bin/insulationctl; do
    if [ -x "$tool" ]; then
      printf '%s\n' "$tool"
      return 0
    fi
  done
  return 1
}

fix_existing_prefs_owner

tool="$(resolve_insulationctl || true)"
if [ -z "$tool" ] || ! "$tool" --clear-removal-marker; then
  echo "insulation: failed to clear the removal marker; package remains disabled" >&2
  exit 1
fi

killall thermalmonitord 2>/dev/null || true
exit 0
