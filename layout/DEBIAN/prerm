#!/bin/bash

resolve_insulationctl() {
  local resolved=""
  resolved="$(command -v insulationctl 2>/dev/null || true)"
  if [ -n "$resolved" ] && [ -x "$resolved" ]; then
    printf '%s\n' "$resolved"
    return 0
  fi

  for tool in \
    /usr/bin/insulationctl \
    /var/jb/usr/bin/insulationctl \
    /var/containers/Bundle/Application/.jbroot-*/usr/bin/insulationctl; do
    if [ -x "$tool" ]; then
      printf '%s\n' "$tool"
      return 0
    fi
  done
  return 1
}

case "${1:-remove}" in
  remove|deconfigure)
    tool="$(resolve_insulationctl || true)"
    if [ -z "$tool" ]; then
      echo "insulation: removal helper is unavailable; aborting removal" >&2
      exit 1
    fi
    if ! "$tool" --prepare-removal; then
      echo "insulation: daemon removal preparation failed; aborting removal" >&2
      exit 1
    fi
    if ! "$tool" --reset-native-state; then
      echo "insulation: native thermal-state cleanup failed; aborting removal" >&2
      exit 1
    fi
    ;;
  upgrade)
    ;;
esac

exit 0
