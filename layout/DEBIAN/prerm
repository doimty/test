#!/bin/bash

reset_native_thermal_state() {
  local resolved=""
  resolved="$(command -v insulationctl 2>/dev/null || true)"
  if [ -n "$resolved" ] && [ -x "$resolved" ]; then
    if "$resolved" --reset-native-state >/dev/null 2>&1; then
      return 0
    fi
  fi

  for tool in \
    /usr/bin/insulationctl \
    /var/jb/usr/bin/insulationctl \
    /var/containers/Bundle/Application/.jbroot-*/usr/bin/insulationctl; do
    if [ -x "$tool" ] && "$tool" --reset-native-state >/dev/null 2>&1; then
      return 0
    fi
  done
  return 1
}

case "${1:-remove}" in
  remove|deconfigure)
    if ! reset_native_thermal_state; then
      echo "insulation: warning: native thermal-state cleanup failed" >&2
    fi
    killall thermalmonitord 2>/dev/null || true
    ;;
  upgrade)
    ;;
esac

exit 0
